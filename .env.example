# PayGate.to Payment Gateway
# Your USDC (Polygon) wallet address to receive instant payouts
PAYGATE_WALLET_ADDRESS=0xYourPolygonUSDCWalletAddressHere
# Same value — exposed to the browser build so the checkout works without a backend
VITE_PAYGATE_WALLET_ADDRESS=0xYourPolygonUSDCWalletAddressHere

# Set automatically by Vercel — do not set manually in production
# VERCEL_URL=your-deployment.vercel.app
